# Admin dashboard authentication. Use unique, long values and do not commit your .env.local file.
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SESSION_SECRET=use-a-long-random-secret-at-least-32-characters

# Google Drive folder that receives a JSON record for each volunteer submission
